{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "/src/*": ["src/*"],
      "/views/*": ["renderer/views/*"],
      "/dom.js": ["renderer/dom.js"]
    }
  },
  "include": [
    "src/**/*.mjs",
    "server/**/*.mjs",
    "scripts/**/*.mjs",
    "renderer/**/*.js",
    "tests/**/*.mts"
  ],
  "exclude": ["node_modules"]
}
